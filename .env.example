# Runtime / deploy
NODE_ENV=development
PORT=3333
FRONTEND_ORIGIN=http://localhost:5173
NEXORA_DB_PATH=./backend/nexora.sqlite
NEXORA_STORAGE_PATH=./backend/storage

# Cloud database and storage
DATABASE_URL=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Public frontend API base URL (use the deployed backend URL on Vercel/Render)
VITE_API_URL=http://localhost:3333

# Auth and billing
NEXORA_JWT_SECRET=troque-por-um-segredo-forte
NEXORA_ENABLE_SIMULATED_BILLING=true
NEXORA_ENFORCE_SUBSCRIPTIONS=false

# AI provider selection
AI_PROVIDER=local
AI_API_KEY=
