# Runtime
NODE_ENV=production
PORT=10000
FRONTEND_ORIGIN=https://<username>.github.io
NEXORA_DB_PATH=
NEXORA_STORAGE_PATH=
DATABASE_URL=postgresql://user:password@host/dbname
SUPABASE_URL=https://xxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Public frontend API base URL (set to deployed backend URL on Render)
VITE_API_URL=https://<backend>.onrender.com/api

# Nexora authentication (never commit this, set only on Render panel)
NEXORA_JWT_SECRET=

# AI provider selection (for example: puter or local)
AI_PROVIDER=puter

# Only required if an explicitly supported external provider is configured.
# Keep empty unless that provider is intentionally enabled.
AI_API_KEY=

