# Runtime
NODE_ENV=
PORT=
FRONTEND_ORIGIN=
NEXORA_DB_PATH=
NEXORA_STORAGE_PATH=
DATABASE_URL=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Public frontend API base URL (set this to the deployed backend URL on Vercel)
VITE_API_URL=

# Nexora authentication
NEXORA_JWT_SECRET=

# AI provider selection (for example: puter or local)
AI_PROVIDER=

# Only required if an explicitly supported external provider is configured.
# Keep empty unless that provider is intentionally enabled.
AI_API_KEY=
